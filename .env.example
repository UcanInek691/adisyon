# ==========================================================================
# Ortam Değişkenleri (ÖRNEK). Gerçek .env dosyası git'e GİRMEZ.
# Kullanım: bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
# ==========================================================================

# --- Veritabanı (Faz 1: SQLite) ---
DATABASE_URL="file:./prisma/dev.db"

# --- API ---
API_PORT="3001"
API_HOST="0.0.0.0"           # LAN'daki Waiter istemcileri için 0.0.0.0

# --- Auth / JWT ---
JWT_ACCESS_SECRET="[JWT_ACCESS_SECRET]"
JWT_REFRESH_SECRET="[JWT_REFRESH_SECRET]"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Lisans (imza doğrulama) ---
# Public key uygulamada gömülüdür; private key ASLA burada bulunmaz.
LICENSE_PUBLIC_KEY="[LICENSE_PUBLIC_KEY]"

# --- Güncelleme paketi imzası ---
UPDATE_PUBLIC_KEY="[UPDATE_PUBLIC_KEY]"

# --- Yedek şifreleme ---
BACKUP_ENCRYPTION_KEY="[BACKUP_ENCRYPTION_KEY]"

# --- Loglama ---
LOG_LEVEL="info"             # trace|debug|info|warn|error

# --- Faz 2 (bulut senkron) - Faz 1'de boş ---
CLOUD_API_URL=""
