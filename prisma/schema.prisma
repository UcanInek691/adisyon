// =============================================================================
// Adisyon / POS - Prisma Semasi (Faz 1: SQLite)
// Kaynak tasarim: DATABASE_DESIGN.md  |  Kurallar: CONVENTIONS.md
//
// GENEL KURALLAR (DATABASE_DESIGN.md §0):
//  - Birincil anahtar: id = ULID (uygulama uretir; auto-increment YOK).
//  - SyncBase alanlari HER modelde bulunur (audit_logs haric - degismezlik).
//  - Para: Int "kurus". Miktar: Int "milis" (x1000). Oran: Int "binde" (permille).
//  - Enum: SQLite native desteklemez -> String + @ado/shared ile dogrulama.
//  - JSON: SQLite'ta guvenli olmasi icin String (TEXT) olarak saklanir; uygulama
//    serialize/deserialize eder.
//  - Soft delete: deleted_at (tombstone). Fiziksel silme yok.
//  - Cross-cutting alanlar (branch_id, device_id, *_by kullanici referanslari)
//    bilincli olarak Prisma iliskisi DEGIL, indeksli String kolon olarak tutulur;
//    boylece Branch/Device/User modelleri onlarca ters-iliskiyle sismez.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// FAZ 2 HAZIRLIK: Tenant / Branch
// =============================================================================

model Tenant {
  id        String   @id
  name      String
  licenseId String?  @map("license_id")
  status    String   @default("active")
  branches  Branch[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@map("tenants")
}

model Branch {
  id        String  @id
  tenantId  String  @map("tenant_id")
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  name      String
  address   String?
  phone     String?
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([tenantId])
  @@map("branches")
}

// =============================================================================
// KIMLIK & YETKI
// =============================================================================

model User {
  id               String    @id
  branchId         String    @map("branch_id")
  username         String    @unique
  displayName      String    @map("display_name")
  passwordHash     String?   @map("password_hash") // Owner (argon2)
  pinHash          String?   @map("pin_hash") // Waiter
  roleId           String    @map("role_id")
  role             Role      @relation(fields: [roleId], references: [id])
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  sessions         Session[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@index([roleId])
  @@map("users")
}

model Role {
  id              String           @id
  name            String
  isSystem        Boolean          @default(false) @map("is_system")
  description     String?
  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@map("roles")
}

model Permission {
  id              String           @id
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@map("permissions")
}

model RolePermission {
  id           String     @id
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  sessionDeviceId  String?   @map("session_device_id") // oturumun cihazi (device_id ile karismasin)
  refreshTokenHash String    @map("refresh_token_hash")
  issuedAt         DateTime  @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ip               String?
  userAgent        String?   @map("user_agent")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([userId])
  @@map("sessions")
}

model Device {
  id              String   @id
  branchId        String   @map("branch_id")
  name            String
  fingerprintHash String   @map("fingerprint_hash")
  platform        String?
  firstSeenAt     DateTime @map("first_seen_at")
  lastSeenAt      DateTime @map("last_seen_at")
  isTrusted       Boolean  @default(false) @map("is_trusted")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("devices")
}

// =============================================================================
// KATALOG
// =============================================================================

model Category {
  id        String     @id
  branchId  String     @map("branch_id")
  name      String
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0) @map("sort_order")
  color     String?
  isActive  Boolean    @default(true) @map("is_active")
  products  Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("categories")
}

model Brand {
  id       String    @id
  branchId String    @map("branch_id")
  name     String
  isActive Boolean   @default(true) @map("is_active")
  products Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("brands")
}

model Unit {
  id           String    @id
  branchId     String    @map("branch_id")
  name         String
  abbreviation String?
  products     Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("units")
}

model Tax {
  id           String    @id
  branchId     String    @map("branch_id")
  name         String
  ratePermille Int       @map("rate_permille") // %10 -> 100
  isDefault    Boolean   @default(false) @map("is_default")
  products     Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("taxes")
}

model Product {
  id             String          @id
  branchId       String          @map("branch_id")
  categoryId     String          @map("category_id")
  category       Category        @relation(fields: [categoryId], references: [id])
  brandId        String?         @map("brand_id")
  brand          Brand?          @relation(fields: [brandId], references: [id])
  unitId         String          @map("unit_id")
  unit           Unit            @relation(fields: [unitId], references: [id])
  taxId          String          @map("tax_id")
  tax            Tax             @relation(fields: [taxId], references: [id])
  name           String
  barcode        String?
  sku            String?
  purchasePrice  Int             @default(0) @map("purchase_price") // kurus
  salePrice      Int             @map("sale_price") // kurus
  trackStock     Boolean         @default(false) @map("track_stock")
  minStock       Int?            @map("min_stock") // milis
  imagePath      String?         @map("image_path")
  isActive       Boolean         @default(true) @map("is_active")
  isFavorite     Boolean         @default(false) @map("is_favorite")
  sortOrder      Int             @default(0) @map("sort_order")
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId, categoryId, isActive])
  @@index([barcode])
  @@map("products")
}

model Discount {
  id                  String  @id
  branchId            String  @map("branch_id")
  name                String
  type                String // percent | amount
  value               Int // binde (percent) veya kurus (amount)
  maxPercentForWaiter Int?    @map("max_percent_for_waiter") // binde
  isActive            Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("discounts")
}

// =============================================================================
// MASA & SALON
// =============================================================================

model Hall {
  id        String  @id
  branchId  String  @map("branch_id")
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")
  tables    Table[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("halls")
}

model Table {
  id           String  @id
  branchId     String  @map("branch_id")
  hallId       String  @map("hall_id")
  hall         Hall    @relation(fields: [hallId], references: [id])
  name         String
  status       String  @default("empty") // TableStatus
  seats        Int     @default(4)
  posX         Int?    @map("pos_x")
  posY         Int?    @map("pos_y")
  mergedIntoId String? @map("merged_into_id")
  mergedInto   Table?  @relation("TableMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Table[] @relation("TableMerge")
  isActive     Boolean @default(true) @map("is_active")
  orders       Order[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId, hallId])
  @@map("tables")
}

// =============================================================================
// SATIS: SIPARIS & ADISYON
// =============================================================================

model Order {
  id            String          @id
  branchId      String          @map("branch_id")
  tableId       String?         @map("table_id")
  table         Table?          @relation(fields: [tableId], references: [id])
  orderNo       String          @map("order_no") // YYYYMMDD-#### (insan-okur)
  status        String          @default("open") // OrderStatus
  openedBy      String          @map("opened_by") // user id (plain)
  openedAt      DateTime        @map("opened_at")
  closedBy      String?         @map("closed_by")
  closedAt      DateTime?       @map("closed_at")
  guestCount    Int             @default(1) @map("guest_count")
  note          String?
  subtotal      Int             @default(0) // kurus
  discountTotal Int             @default(0) @map("discount_total")
  serviceCharge Int             @default(0) @map("service_charge")
  coverCharge   Int             @default(0) @map("cover_charge")
  taxTotal      Int             @default(0) @map("tax_total")
  grandTotal    Int             @default(0) @map("grand_total")
  isPaid        Boolean         @default(false) @map("is_paid")
  parentOrderId String?         @map("parent_order_id")
  parentOrder   Order?          @relation("OrderSplit", fields: [parentOrderId], references: [id])
  childOrders   Order[]         @relation("OrderSplit")
  items         OrderItem[]
  payments      Payment[]
  discounts     OrderDiscount[]
  receipts      Receipt[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  /// Offline istemci mutasyon kimligi (idempotency + izlenebilirlik). Bkz. OFFLINE_DESIGN.md §6
  clientOpId String? @unique @map("client_op_id") // ULID (OPEN_TABLE mutasyonu)

  @@unique([branchId, orderNo])
  @@index([branchId, status])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id                  String          @id
  orderId             String          @map("order_id")
  order               Order           @relation(fields: [orderId], references: [id])
  productId           String          @map("product_id")
  product             Product         @relation(fields: [productId], references: [id])
  productNameSnapshot String          @map("product_name_snapshot")
  unitPrice           Int             @map("unit_price") // kurus (snapshot)
  quantity            Int // milis (x1000)
  taxRatePermille     Int             @map("tax_rate_permille") // snapshot
  lineDiscount        Int             @default(0) @map("line_discount")
  lineTotal           Int             @map("line_total")
  status              String          @default("pending") // OrderItemStatus
  addedBy             String          @map("added_by")
  sentToKitchenAt     DateTime?       @map("sent_to_kitchen_at")
  voidedBy            String?         @map("voided_by")
  voidReason          String?         @map("void_reason")
  notes               OrderItemNote[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  /// Offline istemci mutasyon kimligi (idempotency + izlenebilirlik). Bkz. OFFLINE_DESIGN.md §6
  clientOpId String? @unique @map("client_op_id") // ULID (ADD_LINE mutasyonu)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemNote {
  id          String    @id
  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  note        String
  type        String // waiter | kitchen
  createdBy   String    @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([orderItemId])
  @@map("order_item_notes")
}

model OrderDiscount {
  id         String  @id
  orderId    String  @map("order_id")
  order      Order   @relation(fields: [orderId], references: [id])
  discountId String? @map("discount_id")
  type       String // percent | amount
  value      Int
  amount     Int // hesaplanan tutar (kurus)
  appliedBy  String  @map("applied_by")
  reason     String?
  approvedBy String? @map("approved_by") // Waiter >%10 ise Owner

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([orderId])
  @@map("order_discounts")
}

// =============================================================================
// ODEME (APPEND-ONLY: UPDATE/DELETE YOK)
// =============================================================================

model Payment {
  id                String    @id
  orderId           String    @map("order_id")
  order             Order     @relation(fields: [orderId], references: [id])
  method            String // PaymentMethod
  direction         String    @default("charge") // charge | refund
  amount            Int // kurus
  received          Int       @default(0) // nakit verilen
  change            Int       @default(0) // para ustu
  reference         String? // kart/havale ref
  takenBy           String    @map("taken_by")
  paidAt            DateTime  @map("paid_at")
  reversesPaymentId String?   @map("reverses_payment_id")
  reverses          Payment?  @relation("PaymentReversal", fields: [reversesPaymentId], references: [id])
  reversedBy        Payment[] @relation("PaymentReversal")
  idempotencyKey    String    @unique @map("idempotency_key")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([orderId])
  @@map("payments")
}

model Receipt {
  id              String    @id
  orderId         String    @map("order_id")
  order           Order     @relation(fields: [orderId], references: [id])
  receiptNo       String    @map("receipt_no")
  type            String // customer | kitchen | bar
  printedAt       DateTime  @map("printed_at")
  printerId       String?   @map("printer_id")
  printer         Printer?  @relation(fields: [printerId], references: [id])
  contentSnapshot String    @map("content_snapshot") // yapisal JSON (TEXT)
  reprintOfId     String?   @map("reprint_of")
  reprintOf       Receipt?  @relation("ReceiptReprint", fields: [reprintOfId], references: [id])
  reprints        Receipt[] @relation("ReceiptReprint")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([orderId])
  @@map("receipts")
}

// =============================================================================
// KASA & FINANS (APPEND-ONLY akis)
// =============================================================================

model CashSession {
  id             String            @id
  branchId       String            @map("branch_id")
  sessionDevice  String            @map("session_device") // kasanin cihazi
  openedBy       String            @map("opened_by")
  openedAt       DateTime          @map("opened_at")
  openingFloat   Int               @map("opening_float") // kurus
  closedBy       String?           @map("closed_by")
  closedAt       DateTime?         @map("closed_at")
  countedAmount  Int?              @map("counted_amount")
  expectedAmount Int?              @map("expected_amount")
  difference     Int?              @map("difference") // kasa farki
  status         String            @default("open") // open | closed
  businessDay    String            @map("business_day") // ayarlanabilir gun sonu (YYYY-MM-DD)
  transactions   CashTransaction[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId, businessDay, status])
  @@map("cash_sessions")
}

model CashTransaction {
  id               String      @id
  cashSessionId    String      @map("cash_session_id")
  cashSession      CashSession @relation(fields: [cashSessionId], references: [id])
  type             String // CashTxnType
  amount           Int // kurus (+/-)
  method           String // PaymentMethod
  relatedPaymentId String?     @map("related_payment_id")
  relatedExpenseId String?     @map("related_expense_id")
  createdBy        String      @map("created_by")
  note             String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([cashSessionId])
  @@map("cash_transactions")
}

model ExpenseCategory {
  id       String    @id
  branchId String    @map("branch_id")
  name     String
  isActive Boolean   @default(true) @map("is_active")
  expenses Expense[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("expense_categories")
}

model Expense {
  id          String          @id
  branchId    String          @map("branch_id")
  categoryId  String          @map("category_id")
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Int // kurus
  description String?
  spentAt     DateTime        @map("spent_at")
  affectsCash Boolean         @default(true) @map("affects_cash")
  createdBy   String          @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId, categoryId])
  @@map("expenses")
}

model Income {
  id          String   @id
  branchId    String   @map("branch_id")
  category    String?
  amount      Int // kurus
  description String?
  receivedAt  DateTime @map("received_at")
  affectsCash Boolean  @default(true) @map("affects_cash")
  createdBy   String   @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("incomes")
}

// =============================================================================
// MUSTERI & VERESIYE (APPEND-ONLY hareket)
// =============================================================================

model Customer {
  id          String       @id
  branchId    String       @map("branch_id")
  name        String
  phone       String?
  address     String?
  taxNo       String?      @map("tax_no")
  nationalId  String?      @map("national_id")
  note        String?
  isActive    Boolean      @default(true) @map("is_active")
  debtAccount DebtAccount?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@index([phone])
  @@map("customers")
}

model DebtAccount {
  id           String            @id
  customerId   String            @unique @map("customer_id")
  customer     Customer          @relation(fields: [customerId], references: [id])
  balance      Int               @default(0) // kurus (cache; kaynak = hareketler)
  currency     String            @default("TRY")
  transactions DebtTransaction[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@map("debt_accounts")
}

model DebtTransaction {
  id               String      @id
  debtAccountId    String      @map("debt_account_id")
  debtAccount      DebtAccount @relation(fields: [debtAccountId], references: [id])
  type             String // debt_add | payment
  amount           Int // kurus (+/-)
  relatedOrderId   String?     @map("related_order_id")
  relatedPaymentId String?     @map("related_payment_id")
  createdBy        String      @map("created_by")
  note             String?
  occurredAt       DateTime    @map("occurred_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([debtAccountId])
  @@map("debt_transactions")
}

// =============================================================================
// STOK
// =============================================================================

model Supplier {
  id        String     @id
  branchId  String     @map("branch_id")
  name      String
  phone     String?
  note      String?
  isActive  Boolean    @default(true) @map("is_active")
  purchases Purchase[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("suppliers")
}

model Purchase {
  id          String         @id
  branchId    String         @map("branch_id")
  supplierId  String         @map("supplier_id")
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  invoiceNo   String?        @map("invoice_no")
  total       Int // kurus
  purchasedAt DateTime       @map("purchased_at")
  createdBy   String         @map("created_by")
  items       PurchaseItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId, supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id
  purchaseId String   @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int // milis
  unitCost   Int      @map("unit_cost") // kurus
  lineTotal  Int      @map("line_total")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model StockMovement {
  id                 String   @id
  branchId           String   @map("branch_id")
  productId          String   @map("product_id")
  product            Product  @relation(fields: [productId], references: [id])
  type               String // StockMovementType
  quantity           Int // milis (+/-)
  relatedOrderItemId String?  @map("related_order_item_id")
  relatedPurchaseId  String?  @map("related_purchase_id")
  createdBy          String   @map("created_by")
  occurredAt         DateTime @map("occurred_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([productId])
  @@map("stock_movements")
}

// =============================================================================
// YAZDIRMA
// =============================================================================

model Printer {
  id           String       @id
  branchId     String       @map("branch_id")
  name         String
  driverId     String       @map("driver_id") // eklenti id
  connection   String // PrinterConnection
  address      String? // USB path / IP:port / spooler adi
  paperWidth   Int          @map("paper_width") // 58 | 80
  isDefault    Boolean      @default(false) @map("is_default")
  capabilities String? // JSON (TEXT): cutter, drawer, qr...
  isActive     Boolean      @default(true) @map("is_active")
  printJobs    PrintJob[]
  printRoutes  PrintRoute[]
  receipts     Receipt[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("printers")
}

model PrintRoute {
  id           String  @id
  branchId     String  @map("branch_id")
  documentType String  @map("document_type") // DocumentType
  printerId    String  @map("printer_id")
  printer      Printer @relation(fields: [printerId], references: [id])
  categoryId   String? @map("category_id") // kategoriye ozel mutfak (plain)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId, documentType])
  @@map("print_routes")
}

model PrintJob {
  id           String    @id
  branchId     String    @map("branch_id")
  printerId    String    @map("printer_id")
  printer      Printer   @relation(fields: [printerId], references: [id])
  documentType String    @map("document_type")
  payload      String // soyut PrintDocument (JSON TEXT)
  status       String    @default("queued") // PrintJobStatus
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  createdBy    String    @map("created_by")
  printedAt    DateTime? @map("printed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([status])
  @@map("print_jobs")
}

// =============================================================================
// SISTEM · SENKRON · DENETIM · LISANS · GUNCELLEME · EKLENTI · YEDEK
// =============================================================================

model ApplicationSetting {
  id        String  @id
  branchId  String  @map("branch_id")
  key       String
  value     String // JSON (TEXT)
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@unique([branchId, key])
  @@map("application_settings")
}

/// APPEND-ONLY + HASH ZINCIRI. version/updated_at/deleted_at TASIMAZ (degismezlik).
model AuditLog {
  id         String  @id
  branchId   String  @map("branch_id")
  userId     String? @map("user_id")
  action     String // AuditAction
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  oldValue   String? @map("old_value") // JSON (TEXT)
  newValue   String? @map("new_value") // JSON (TEXT)
  reason     String?
  prevHash   String  @map("prev_hash")
  hash       String // H(prev_hash + kayit alanlari)

  createdAt DateTime @default(now()) @map("created_at")
  deviceId  String?  @map("device_id")
  syncState String   @default("pending") @map("sync_state")

  /// Kaydin kaynagi: online mi yoksa offline replay mi. Bkz. OFFLINE_DESIGN.md §12
  origin          String    @default("online") // AuditOrigin: online | offline
  clientOpId      String?   @map("client_op_id") // offline ise iliskili mutasyon ULID
  clientCreatedAt DateTime? @map("client_created_at") // offline ise istemci uretim zamani

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

/// Outbox: Faz 2 buluta gonderim kuyrugu.
model SyncQueue {
  id             String    @id
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  operation      String // create | update | delete
  payload        String // JSON (TEXT)
  idempotencyKey String    @unique @map("idempotency_key")
  status         String    @default("pending") // pending|syncing|synced|failed
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  sentAt         DateTime? @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  deviceId  String?  @map("device_id")

  @@index([status, createdAt])
  @@map("sync_queue")
}

model SyncStateRecord {
  id           String    @id
  entityType   String    @map("entity_type")
  lastPulledAt DateTime? @map("last_pulled_at")
  lastPushedAt DateTime? @map("last_pushed_at")
  cursor       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sync_state")
}

model Conflict {
  id            String    @id
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  localPayload  String    @map("local_payload") // JSON (TEXT)
  remotePayload String    @map("remote_payload")
  resolution    String? // local | remote | manual
  resolvedBy    String?   @map("resolved_by")
  resolvedAt    DateTime? @map("resolved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@map("conflicts")
}

// =============================================================================
// ISTEMCI-OFFLINE (Faz 1): Waiter tablet -> yerel sunucu. Faz 2 bulut sync'ten AYRI.
// Bkz. OFFLINE_DESIGN.md
// =============================================================================

/// Offline istemci mutasyonlari icin idempotency defteri (append-only).
/// Ayni clientOpId ikinci kez gelirse yeniden islenmez, ilk sonuc doner (replay guvenli).
/// Bkz. OFFLINE_DESIGN.md §6, §9.1
model ProcessedClientOp {
  id           String  @id // ULID
  clientOpId   String  @unique @map("client_op_id") // ULID (istemci uretimi)
  deviceId     String  @map("device_id")
  mutationType String  @map("mutation_type") // OfflineMutationType
  resultStatus String  @map("result_status") // OfflineMutationResult: applied | conflict | rejected
  resultRef    String? @map("result_ref") // olusan varlik id (varsa)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([deviceId, createdAt])
  @@map("processed_client_ops")
}

/// Otomatik uygulanamayan (cakisan) offline mutasyonlarin Owner onay kuyrugu (Faz 1).
/// Faz 2 bulut `Conflict` modelinden bilincli olarak ayridir. Bkz. OFFLINE_DESIGN.md §8, §9.2
model PendingOfflineReview {
  id              String    @id // ULID
  branchId        String    @map("branch_id")
  deviceId        String    @map("device_id") // mutasyonu ureten tablet
  waiterId        String    @map("waiter_id")
  clientOpId      String    @map("client_op_id")
  mutationType    String    @map("mutation_type") // OfflineMutationType
  mutationPayload String    @map("mutation_payload") // JSON (TEXT)
  reason          String // OfflineReviewReason: table_closed | table_moved | product_inactive | other
  status          String    @default("open") // OfflineReviewStatus: open | resolved | rejected
  resolution      String? // yeni_adisyon | yeniden_ac | reddet
  resolvedBy      String?   @map("resolved_by")
  resolvedAt      DateTime? @map("resolved_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId, status])
  @@index([clientOpId])
  @@map("pending_offline_reviews")
}

model LicenseInfo {
  id             String    @id
  licenseKey     String    @map("license_key")
  customerName   String    @map("customer_name")
  plan           String?
  features       String? // JSON (TEXT) feature-flags
  status         String    @default("active") // LicenseStatus
  validUntil     DateTime? @map("valid_until")
  activatedAt    DateTime? @map("activated_at")
  lastVerifiedAt DateTime? @map("last_verified_at")
  graceUntil     DateTime? @map("grace_until")
  signatureValid Boolean   @default(false) @map("signature_valid")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@map("license_info")
}

model UpdateHistory {
  id           String    @id
  fromVersion  String    @map("from_version")
  toVersion    String    @map("to_version")
  channel      String // stable | beta
  status       String // UpdateStatus
  appliedAt    DateTime? @map("applied_at")
  backupId     String?   @map("backup_id")
  rolledBackAt DateTime? @map("rolled_back_at")
  initiatedBy  String    @map("initiated_by")
  error        String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@map("update_history")
}

model Plugin {
  id             String   @id
  pluginId       String   @map("plugin_id") // manifest id
  name           String
  pluginVersion  String   @map("plugin_version")
  type           String // report | printer
  enabled        Boolean  @default(true)
  manifest       String // JSON (TEXT)
  compatibleCore String   @map("compatible_core")
  installedAt    DateTime @map("installed_at")
  installedBy    String   @map("installed_by")
  loadError      String?  @map("load_error")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@unique([pluginId])
  @@map("plugins")
}

model Backup {
  id        String  @id
  branchId  String  @map("branch_id")
  path      String
  sizeBytes Int     @map("size_bytes")
  type      String // auto | manual | pre_update
  encrypted Boolean @default(true)
  checksum  String
  createdBy String? @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("backups")
}

model ReportDefinition {
  id                  String  @id
  reportId            String  @map("report_id") // eklenti id
  name                String
  reportVersion       String  @map("report_version")
  requiredPermissions String  @map("required_permissions") // JSON (TEXT)
  isEnabled           Boolean @default(true) @map("is_enabled")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@unique([reportId])
  @@map("report_definitions")
}
