model Supplier {
  id        String     @id
  branchId  String     @map("branch_id")
  name      String
  phone     String?
  note      String?
  isActive  Boolean    @default(true) @map("is_active")
  purchases Purchase[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId])
  @@map("suppliers")
}

model Purchase {
  id          String         @id
  branchId    String         @map("branch_id")
  supplierId  String         @map("supplier_id")
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  invoiceNo   String?        @map("invoice_no")
  total       Int // kurus
  purchasedAt DateTime       @map("purchased_at")
  createdBy   String         @map("created_by")
  items       PurchaseItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([branchId, supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id
  purchaseId String   @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String   @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int // milis
  unitCost   Int      @map("unit_cost") // kurus
  lineTotal  Int      @map("line_total")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model StockMovement {
  id                 String   @id
  branchId           String   @map("branch_id")
  productId          String   @map("product_id")
  product            Product  @relation(fields: [productId], references: [id])
  type               String // StockMovementType
  quantity           Int // milis (+/-)
  relatedOrderItemId String?  @map("related_order_item_id")
  relatedPurchaseId  String?  @map("related_purchase_id")
  createdBy          String   @map("created_by")
  occurredAt         DateTime @map("occurred_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)
  deviceId  String?   @map("device_id")
  syncState String    @default("pending") @map("sync_state")

  @@index([productId])
  @@map("stock_movements")
}
