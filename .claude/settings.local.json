{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787"
  },
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "Bash(pnpm --version)",
      "Bash(git --version)",
      "Bash(rtk --version)",
      "Bash(pnpm install *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm --filter @ado/shared exec tsc --noEmit)",
      "Bash(echo \"EXIT: $?\")",
      "Bash(git init *)",
      "Bash(git config *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git commit -q -m ' *)"
    ]
  }
}
